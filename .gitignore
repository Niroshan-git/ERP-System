# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
id_ed25519*
id_rsa*

# --- Node / Next.js (apps/frontend, apps/mcp-server if TS) ---
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml
