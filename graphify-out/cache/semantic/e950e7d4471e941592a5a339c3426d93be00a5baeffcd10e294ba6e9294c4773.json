{"nodes": [{"id": "docs_backend_05_manufacturing_work_order_work_order", "label": "Work Order", "file_type": "document", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_05_manufacturing_work_order_work_order_item", "label": "Work Order Item (required_items)", "file_type": "document", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_05_manufacturing_work_order_work_order_operation", "label": "Work Order Operation (operations)", "file_type": "document", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_05_manufacturing_work_order_mfg_val_001", "label": "MFG-VAL-001 Production Item create restriction", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend-only restriction: New Work Order only lists items with default_bom set, this app's own definition of 'manufacturable', not an ERPNext DocType constraint."}, {"id": "docs_backend_05_manufacturing_work_order_mfg_calc_001", "label": "MFG-CALC-001 Required qty scaling", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "required_qty = bom_item.qty * (work_order.qty / bom.quantity), computed server-side by ERPNext on insert; the frontend's BOM preview only mirrors this for display, never sends it."}, {"id": "docs_backend_05_manufacturing_work_order_mfg_val_002", "label": "MFG-VAL-002 Update-after-submit block", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither required_items nor any Work Order Item child field carries allow_on_submit:1, so Frappe's core _validate_update_after_submit() rejects any edit once docstatus=1; this is core Frappe safety, not a gap, with MFG-WF-002 as the real native path."}, {"id": "docs_backend_05_manufacturing_work_order_mfg_val_003", "label": "MFG-VAL-003 Draft-stage required_qty reversion", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While allow_editing_of_items_and_quantities_in_work_order=0, every save calls set_required_items(reset_only_qty=True) which resets required_qty but never resets item_code, so a raw item substitution on a Draft row persists even though qty edits are silently reverted."}, {"id": "docs_backend_05_manufacturing_work_order_mfg_wf_001", "label": "MFG-WF-001 Create-only lifecycle in this frontend", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This frontend only ever calls createDoc, never submitDoc/cancelDoc on Work Order itself; every created Work Order stays at docstatus 0 (Draft) from this app's perspective."}, {"id": "docs_backend_05_manufacturing_work_order_mfg_wf_002", "label": "MFG-WF-002 Stock-Entry-driven material deviation", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ERPNext-native mechanism for a Work-Order-specific material deviation is Stock-Entry-driven, not a Work Order edit \u2014 a deliberate Package 4 investigation outcome, not an assumption."}, {"id": "docs_backend_05_manufacturing_work_order_mfg_unv_004a", "label": "MFG-UNV-004a operations table stays empty on REST insert", "file_type": "concept", "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_backend_05_manufacturing_work_order_work_order", "target": "docs_backend_05_manufacturing_work_order_work_order_item", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_work_order_work_order", "target": "docs_backend_05_manufacturing_work_order_work_order_operation", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_work_order_work_order_item", "target": "docs_backend_05_manufacturing_material_transfer_material_transfer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_work_order_mfg_val_002", "target": "docs_backend_05_manufacturing_work_order_work_order_item", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/work-order.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_work_order_mfg_calc_001", "target": "docs_backend_05_manufacturing_work_order_work_order_item", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/work-order.md