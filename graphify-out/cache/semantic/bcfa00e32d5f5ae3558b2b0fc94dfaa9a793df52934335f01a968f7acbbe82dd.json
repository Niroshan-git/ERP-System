{"nodes": [{"id": "docs_backend_05_manufacturing_material_transfer_material_transfer", "label": "Material Transfer for Manufacture", "file_type": "document", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_05_manufacturing_material_transfer_make_stock_entry", "label": "erpnext.work_order.make_stock_entry", "file_type": "code", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_05_manufacturing_material_transfer_mfg_stk_001", "label": "MFG-STK-001 fg_completed_qty gate", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERPNext's Stock Entry.update_work_order only calls add_additional_items()/update_work_order_qty() when fg_completed_qty is truthy; omitting it let a Stock Entry submit cleanly while silently never attaching the additional item to required_items. Fixed by threading preview.fg_completed_qty through the form and validating presence before submit."}, {"id": "docs_backend_05_manufacturing_material_transfer_mfg_stk_002", "label": "MFG-STK-002 Additional material lifecycle", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submitting an extra non-BOM item line calls add_additional_items(), inserting a Work Order Item row with is_additional_item=1 and voucher_detail_reference, bypassing the update-after-submit block because it is a targeted server-side child-row insert, not doc.save(). Cancelling calls remove_additional_items()."}, {"id": "docs_backend_05_manufacturing_material_transfer_mfg_stk_003", "label": "MFG-STK-003 Quantity headroom", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Total transferable qty per item is capped at required_qty * (1 + Manufacturing Settings.transfer_extra_materials_percentage/100), currently 0% on this instance; live-confirmed rejection of a 200-unit excess transfer."}, {"id": "docs_backend_05_manufacturing_material_transfer_mfg_val_004", "label": "MFG-VAL-004 Warehouse validity server-side", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERPNext independently rejects a group warehouse server-side even though the frontend's warehouse picker already filters to is_group=0, disabled=0."}, {"id": "docs_backend_05_manufacturing_material_transfer_mfg_wf_003", "label": "MFG-WF-003 Draft never moves stock", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only Submit moves stock; a Draft Material Transfer for Manufacture Stock Entry leaves Bin.actual_qty and transferred_qty unchanged, so the frontend exposes saveTransferDraftAction and submitTransferAction as two separate actions rather than one implicit save-and-submit."}, {"id": "docs_backend_05_manufacturing_material_transfer_mfg_val_005", "label": "MFG-VAL-005 Batch/serial guard", "file_type": "rationale", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend-only safety: rows whose item has has_batch_no/has_serial_no are disabled in the form since no batch/serial picker UI exists yet; not an ERPNext-enforced block at this step."}, {"id": "docs_backend_05_manufacturing_material_transfer_cantransfermaterials", "label": "canTransferMaterials() eligibility gate", "file_type": "code", "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_backend_05_manufacturing_material_transfer_material_transfer", "target": "docs_backend_05_manufacturing_work_order_work_order", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_material_transfer_material_transfer", "target": "docs_backend_05_manufacturing_material_transfer_make_stock_entry", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_material_transfer_mfg_stk_001", "target": "docs_backend_05_manufacturing_material_transfer_material_transfer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_material_transfer_mfg_stk_002", "target": "docs_backend_05_manufacturing_material_transfer_material_transfer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend/05-manufacturing/material-transfer.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_05_manufacturing_material_transfer_mfg_stk_003", "target": "docs_backend_05_manufacturing_material_transfer_material_transfer", "relation": "rationale_for", "c